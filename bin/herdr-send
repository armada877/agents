#!/usr/bin/env python3

import argparse
import json
import re
import subprocess
import sys
import time


SGR = re.compile(r"\x1b\[[0-9;:]*m")
DIM_SPAN = re.compile(r"\x1b\[2m.*?(?:\x1b\[0m|$)")


def input_is_empty(screen):
    for line in reversed(screen.splitlines()):
        plain = SGR.sub("", line)
        if plain.startswith(("›", "❯")):
            visible = SGR.sub("", DIM_SPAN.sub("", line))
            return visible.startswith(("›", "❯")) and not visible[1:].strip()
    return False


def agent_status(agent_name):
    result = subprocess.run(
        ["herdr", "agent", "get", agent_name], capture_output=True, text=True
    )
    if result.returncode:
        raise ValueError(f"agent {agent_name} not found")
    try:
        return json.loads(result.stdout)["result"]["agent"]["agent_status"]
    except (ValueError, KeyError, TypeError):
        raise ValueError(f"agent {agent_name} not found") from None


def read_input(agent_name):
    result = subprocess.run(
        ["herdr", "agent", "read", agent_name, "--source", "visible", "--format", "ansi"],
        capture_output=True,
        text=True,
    )
    return result.returncode == 0 and input_is_empty(result.stdout)


def send_when_ready(args):
    deadline = None if args.timeout is None else time.monotonic() + args.timeout / 1000
    previous_ready = False
    while True:
        status = agent_status(args.agent)
        empty = read_input(args.agent) if status in ("idle", "done") else False
        ready = status in ("idle", "done") and empty
        if deadline is not None and time.monotonic() >= deadline:
            state = "empty" if empty else "typed"
            print(
                f"herdr-send: timeout, {args.agent} not ready ({status}, input {state})",
                file=sys.stderr,
            )
            return 2
        if ready and previous_ready:
            return subprocess.run(
                [
                    "herdr", "agent", "prompt", args.agent, args.text,
                    "--wait", "--until", "working", "--until", "blocked",
                    "--timeout", "10000",
                ]
            ).returncode
        previous_ready = ready
        delay = args.interval
        if deadline is not None:
            delay = min(delay, max(0, deadline - time.monotonic()))
        time.sleep(delay)


def main():
    parser = argparse.ArgumentParser(
        description="Returns when the agent starts the turn."
    )
    parser.add_argument("agent")
    parser.add_argument("text")
    parser.add_argument("--timeout", type=float)
    parser.add_argument("--interval", type=float, default=2)
    args = parser.parse_args()
    if args.interval <= 0 or (args.timeout is not None and args.timeout < 0):
        parser.error("timeout must be nonnegative and interval must be positive")
    try:
        return send_when_ready(args)
    except (ValueError, OSError) as error:
        print(f"herdr-send: {str(error).splitlines()[0]}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
