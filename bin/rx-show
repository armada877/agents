#!/bin/bash

set -euo pipefail

usage() {
  echo "Usage: rx-show <file.md | image>" >&2
  exit 1
}

(($# == 1)) || usage
[[ -f $1 ]] || usage

source_file="$(realpath -- "$1")"
file_name="$(basename "$source_file")"
push_config="${XDG_CONFIG_HOME:-$HOME/.config}/hc/push-command"

is_markdown() {
  [[ $source_file == *.md || $source_file == *.markdown ]]
}

is_image() {
  local lower
  lower="$(printf '%s' "$source_file" | tr '[:upper:]' '[:lower:]')"
  [[ $lower =~ \.(png|jpe?g|gif|webp)$ ]]
}

viewer() {
  if is_markdown; then
    echo glow -t
  else
    echo less
  fi
}

open_window() {
  local label="rx-show · $file_name"
  local -a view command
  local session old_blocks old opened
  if is_image; then
    label="$file_name preview"
    view=("$(dirname "$(realpath "$0")")/rx-show-kitty")
  else
    read -ra view <<<"$(viewer)"
  fi
  if is_image && [[ -n ${REX_BLOCK:-} ]]; then
    if ! session="$(rex block inspect "$REX_BLOCK" | awk '/^session:/ {print $2}')" || [[ -z $session ]]; then
      echo "rx-show: could not find the caller session" >&2
      return 0
    fi
    if ! old_blocks="$(rex block ls -s "$session" --json | jq -r --arg label "$label" --arg anchor "$REX_BLOCK" '.blocks[] | select(.label == $label and .block_id != $anchor) | .block_id')"; then
      echo "rx-show: could not find earlier splits" >&2
      return 0
    fi
    while IFS= read -r old; do
      [[ -n $old ]] || continue
      if ! rex block close "$old" >/dev/null; then
        echo "rx-show: could not close an earlier split" >&2
        return 0
      fi
    done <<<"$old_blocks"
    command=(rex split -b "$REX_BLOCK" --split=right --ratio 60)
    opened=split
  else
    command=(rex run)
    opened=tab
  fi
  if old="$("${command[@]}" --focus=false --keep-open --label "$label" -- "${view[@]}" "$source_file")"; then
    echo "rx-show: opened a $opened: $label ($old)" >&2
  else
    echo "rx-show: could not open a $opened" >&2
  fi
}

push_command() {
  [[ -r $push_config ]] || return 1
  grep -v '^[[:space:]]*\(#\|$\)' "$push_config" | head -n 1
}

send_push() {
  local command
  if ! is_markdown; then
    echo "rx-show: no push: only Markdown files go to the phone" >&2
    return 0
  fi
  if ! command="$(push_command)" || [[ -z $command ]]; then
    echo "rx-show: no push: $push_config has no command" >&2
    return 0
  fi
  if "$command" "$source_file"; then
    echo "rx-show: sent a push" >&2
  else
    echo "rx-show: the push failed: $command" >&2
  fi
}

[[ ${RX_SHOW_WINDOW:-1} == 0 ]] || open_window
[[ ${RX_SHOW_PUSH:-1} == 0 ]] || send_push
