#!/usr/bin/env python3

import argparse
import contextlib
import dataclasses
import functools
import hashlib
import ipaddress
import json
import os
import pwd
import re
import subprocess
import stat
import sys
import tarfile
import time
import tomllib
from pathlib import Path


CONFIG_FILE = "hc-sandbox.toml"
ASSETS = Path(os.path.realpath(__file__)).parent / "hc-sandbox.d"
STATE_DIR = ".hc-sandbox"
LABEL = "hc-sandbox"
PASTA_DNS = "169.254.1.1"
BUILD_CAPS = "CHOWN,DAC_OVERRIDE,FOWNER,FSETID,SETUID,SETGID"
BUILDER_CAPS = BUILD_CAPS + ",SYS_ADMIN,SYS_CHROOT"
ASSET_BUILD_CAPS = BUILD_CAPS + ",SETFCAP"
STEP_CAPS = ",".join(f"CAP_{cap}" for cap in BUILD_CAPS.split(","))
BUILDER_STORE = "/var/lib/containers"
HARDENING = ["--cap-drop", "all", "--security-opt", "no-new-privileges"]
LIMITS = ["--memory", "2g", "--pids-limit", "512", "--cpus", "2"]
CONTAINERS_CONF = '[containers]\nlog_driver = "none"\n'
BUILD_LIMITS = ["--memory", "4g"]
BUILDER_LIMITS = ["--memory", "4g", "--pids-limit", "1024", "--cpus", "4"]
GLOBAL_IPV6 = ipaddress.ip_network("2000::/3")
OPEN_DIR = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
BUILD_SCRIPT = (
    'set -e; mkdir /ctx; tar -x -C /ctx -f -; '
    'buildah --storage-driver vfs bud --isolation chroot --network host --cap-drop ALL --cap-add "$1" '
    '--volume /cache:/cache --file "/ctx/$2" --tag hc-sandbox-build /ctx >&2; '
    'buildah --storage-driver vfs push hc-sandbox-build "docker-archive:/tmp/image.tar:$3" >&2; '
    'cat /tmp/image.tar'
)
ENGINE_ENV_KEYS = ("PATH", "HOME", "USER", "LOGNAME", "LANG", "TERM")
DOCKER_DNS = "9.9.9.9"
ENGINE_VARIABLE = "HC_SANDBOX_ENGINE"
SETTINGS_KEYS = {"engine"}
CONFIG_HELP = """config: put hc-sandbox.toml in the worktree root. Only name is required.

  name = "my-app"
  containerfile = "Containerfile"
  port = 8000
  ready_path = "/"
  ready_timeout = 60
  test_command = ["python", "-m", "unittest"]

  [[pages]]
  path = "/"
  expect = "text that the page must show"

The app must listen on the pod address, from the pod host name.
Screenshots go to .hc-sandbox/out/. Use fake data."""
NAME = re.compile(r"^[a-z0-9][a-z0-9-]{0,30}$")
PAGE_PATH = re.compile(r"^/[A-Za-z0-9._~!$&'()*+,;=:@%/?#-]*$")
SAFE_PATH = re.compile(r"^[A-Za-z0-9._/+@-]+$")
CONFIG_KEYS = {"name", "containerfile", "port", "ready_path", "ready_timeout", "test_command", "pages"}
PAGE_KEYS = {"path", "expect"}
BROWSER = ["chromium-browser", "--headless", "--no-sandbox", "--use-angle=swiftshader", "--enable-unsafe-swiftshader",
           "--disable-dev-shm-usage", "--hide-scrollbars", "--user-data-dir=/tmp/chromium",
           "--window-size=1280,800", "--virtual-time-budget=5000"]


class SandboxError(Exception):
    pass


@dataclasses.dataclass(frozen=True)
class Page:
    path: str
    expect: str


@dataclasses.dataclass(frozen=True)
class Config:
    name: str
    containerfile: str = "Containerfile"
    port: int | None = None
    ready_path: str = "/"
    ready_timeout: int = 60
    test_command: tuple[str, ...] = ()
    pages: tuple[Page, ...] = ()


def require(condition, message):
    if not condition:
        raise SandboxError(message)


def parse_pages(raw):
    require(isinstance(raw, list), "pages must be a list of tables")
    pages = []
    for entry in raw:
        require(isinstance(entry, dict) and set(entry) <= PAGE_KEYS and "path" in entry,
                "each page needs path and an optional expect")
        path = entry["path"]
        expect = entry.get("expect", "")
        require(isinstance(path, str) and PAGE_PATH.match(path), f"bad page path: {path!r}")
        require(isinstance(expect, str), "page expect must be a string")
        pages.append(Page(path, expect))
    return tuple(pages)


def parse_config(data):
    unknown = set(data) - CONFIG_KEYS
    require(not unknown, f"unknown keys in {CONFIG_FILE}: {', '.join(sorted(unknown))}")
    name = data.get("name")
    require(isinstance(name, str) and NAME.match(name), "name must match [a-z0-9][a-z0-9-]{0,30}")
    containerfile = data.get("containerfile", "Containerfile")
    require(isinstance(containerfile, str) and SAFE_PATH.match(containerfile)
            and not containerfile.startswith("/") and ".." not in Path(containerfile).parts,
            "containerfile must be a plain relative path in the worktree")
    port = data.get("port")
    require(port is None or (type(port) is int and 1 <= port <= 65535), "port must be 1-65535")
    ready_path = data.get("ready_path", "/")
    require(isinstance(ready_path, str) and PAGE_PATH.match(ready_path), "bad ready_path")
    ready_timeout = data.get("ready_timeout", 60)
    require(type(ready_timeout) is int and 1 <= ready_timeout <= 600, "ready_timeout must be 1-600")
    test_command = data.get("test_command", [])
    require(isinstance(test_command, list) and all(isinstance(part, str) for part in test_command),
            "test_command must be a list of strings")
    pages = parse_pages(data.get("pages", []))
    require(not pages or port, "pages need a port")
    return Config(name, containerfile, port, ready_path, ready_timeout, tuple(test_command), pages)


def find_worktree(start):
    for directory in (start, *start.parents):
        if (directory / CONFIG_FILE).is_file():
            return directory
    raise SandboxError(f"no {CONFIG_FILE} in {start} or its parents")


def home_dir():
    return Path(pwd.getpwuid(os.getuid()).pw_dir).resolve()


def worktrees_root():
    return home_dir() / ".herdr" / "worktrees"


def check_worktree(worktree, root):
    require(SAFE_PATH.match(str(worktree)), f"worktree path has characters that container mounts cannot use: {worktree}")
    require(worktree.is_relative_to(root) and len(worktree.relative_to(root).parts) >= 2,
            f"the worktree must be a folder at least two levels under {root}")


def open_worktree(path, root):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        real = Path(os.readlink(f"/proc/self/fd/{fd}"))
        check_worktree(real, root)
    except BaseException:
        os.close(fd)
        raise
    return fd, real


def open_in(dir_fd, relative, flags):
    parts = Path(relative).parts
    current = os.dup(dir_fd)
    try:
        for part in parts[:-1]:
            child = os.open(part, OPEN_DIR, dir_fd=current)
            os.close(current)
            current = child
        return os.open(parts[-1], flags | os.O_NOFOLLOW, dir_fd=current)
    except OSError as error:
        raise SandboxError(f"cannot open {relative} in the worktree without links: {error.strerror}") from None
    finally:
        os.close(current)


def read_in(dir_fd, relative):
    fd = open_in(dir_fd, relative, os.O_RDONLY)
    require(stat.S_ISREG(os.fstat(fd).st_mode), f"{relative} must be a file")
    with os.fdopen(fd, "rb") as handle:
        return handle.read()


def load_config(worktree_fd):
    config = parse_config(tomllib.loads(read_in(worktree_fd, CONFIG_FILE).decode()))
    read_in(worktree_fd, config.containerfile)
    return config


@dataclasses.dataclass(frozen=True)
class Sandbox:
    worktree: Path
    config: Config
    fd: int = -1

    @property
    def id(self):
        digest = hashlib.sha256(str(self.worktree).encode()).hexdigest()[:8]
        return f"{self.config.name}-{digest}"

    @property
    def image(self):
        return f"localhost/hc-sandbox/{self.id}:latest"

    @property
    def pod(self):
        return f"hcsb-{self.id}"

    @property
    def network(self):
        return f"hcsb-{self.id}"

    @property
    def app(self):
        return f"hcsb-{self.id}-app"

    @property
    def infra(self):
        return f"hcsb-{self.id}-infra"

    @property
    def browser(self):
        return f"hcsb-{self.id}-browser"

    @property
    def egress(self):
        return f"hcsb-{self.id}-egress"

    @property
    def builder(self):
        return f"hcsb-{self.id}-build"

    @property
    def store(self):
        return f"hcsb-store-{self.id}"

    @property
    def cache(self):
        return f"hcsb-cache-{self.id}"

    @property
    def out(self):
        return self.worktree / STATE_DIR / "out"

    def labels(self):
        return ["--label", f"{LABEL}=1", "--label", f"{LABEL}.worktree={self.worktree}"]


def user_runtime_dir():
    return Path(f"/run/user/{os.getuid()}")


def sandbox_runtime_dir():
    return user_runtime_dir() / "hc-sandbox"


def sandbox_storage_dir():
    return home_dir() / ".local" / "share" / "hc-sandbox"


def containers_conf():
    path = sandbox_runtime_dir() / "containers.conf"
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if not path.exists() or path.read_text() != CONTAINERS_CONF:
        path.write_text(CONTAINERS_CONF)
    return path


class Podman:
    name = "podman"

    def env(self):
        env = {key: os.environ[key] for key in ENGINE_ENV_KEYS if key in os.environ}
        env["CONTAINERS_CONF_OVERRIDE"] = str(containers_conf())
        env["XDG_RUNTIME_DIR"] = str(sandbox_runtime_dir())
        env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={user_runtime_dir() / 'bus'}"
        return env

    def globals(self):
        storage, runtime = sandbox_storage_dir(), sandbox_runtime_dir()
        return ["--root", str(storage / "graph"), "--runroot", str(runtime / "containers"),
                "--tmpdir", str(runtime / "libpod" / "tmp"), "--network-config-dir", str(storage / "networks"),
                "--volumepath", str(storage / "volumes")]

    def argv(self, *args):
        for path in (sandbox_storage_dir(), sandbox_runtime_dir()):
            path.mkdir(mode=0o700, parents=True, exist_ok=True)
            path.chmod(0o700)
        return ["podman", *self.globals(), *args]

    def exists_args(self, kind, name):
        return [kind, "exists", name]

    def remove_args(self, name):
        return ["rm", "--force", "--time", "0", name]

    def asset_build_args(self, kind, tag):
        return ["build", "--pull=missing", "--http-proxy=false", "--network", PASTA_NETWORK,
                "--cap-drop", "all", "--cap-add", ASSET_BUILD_CAPS, "--security-opt", "no-new-privileges",
                *BUILD_LIMITS, *asset_build_tail(kind, tag)]

    def egress_network_args(self):
        return ["--network", PASTA_NETWORK, "--dns", PASTA_DNS]

    def create_run_network(self, sandbox, ports):
        run_engine("network", "create", "--internal", "--disable-dns", *sandbox.labels(), sandbox.network, quiet=True)
        run_engine("pod", "create", "--name", sandbox.pod, "--hostname", sandbox.pod, "--network", sandbox.network,
                   *sandbox.labels(), *ports, quiet=True)
        return ["--pod", sandbox.pod], ["--pod", sandbox.pod]

    def remove_run_network(self, sandbox):
        run_engine("pod", "rm", "--force", "--time", "2", sandbox.pod, check=False, quiet=True)
        run_engine("network", "rm", "--force", sandbox.network, check=False, quiet=True)

    def list_sandboxes(self):
        result = run_engine("pod", "ps", "--filter", f"label={LABEL}=1", "--format", "json", capture=True)
        return [(pod["Name"], pod["Status"], (pod.get("Labels") or {}).get(f"{LABEL}.worktree", ""))
                for pod in json.loads(result.stdout or "[]")]

    def helper_log_args(self):
        return []

    def app_log_args(self):
        return ["--log-driver", "k8s-file", "--log-opt", "max-size=10mb"]

    def warnings(self):
        return []


class Docker:
    name = "docker"

    def env(self):
        env = {key: os.environ[key] for key in ENGINE_ENV_KEYS if key in os.environ}
        env["DOCKER_HOST"] = docker_host()
        env["DOCKER_CONFIG"] = str(empty_docker_config())
        return env

    def argv(self, *args):
        return ["docker", *args]

    def exists_args(self, kind, name):
        return [kind, "inspect", name]

    def remove_args(self, name):
        return ["rm", "--force", name]

    def asset_build_args(self, kind, tag):
        return ["build", *asset_build_tail(kind, tag)]

    def egress_network_args(self):
        return ["--network", "bridge", "--dns", DOCKER_DNS]

    def create_run_network(self, sandbox, ports):
        image = asset_tag("egress")
        require(exists("image", image), "no egress image: run hc-sandbox build first")
        run_engine("network", "create", "--internal", *sandbox.labels(), sandbox.network, quiet=True)
        run_engine("run", "--detach", "--name", sandbox.infra, *sandbox.labels(), "--network", sandbox.network,
                   "--hostname", sandbox.pod, *ports, *HARDENING, *LIMITS, *self.helper_log_args(),
                   "--entrypoint", "sleep", image, "infinity", quiet=True)
        run_engine("run", "--rm", *sandbox.labels(), "--network", f"container:{sandbox.infra}",
                   *self.helper_log_args(), "--cap-drop", "all", "--cap-add", "NET_ADMIN",
                   "--security-opt", "no-new-privileges", *LIMITS, "--entrypoint", "nft", image,
                   "-f", "/etc/hc-sandbox/run.nft", quiet=True)
        shared = ["--network", f"container:{sandbox.infra}"]
        return shared, shared

    def remove_run_network(self, sandbox):
        for name in (sandbox.browser, sandbox.app, sandbox.infra):
            run_engine(*self.remove_args(name), check=False, quiet=True)
        run_engine("network", "rm", sandbox.network, check=False, quiet=True)

    def list_sandboxes(self):
        template = "{{.Names}}\t{{.Status}}\t{{.Label \"" + LABEL + ".worktree\"}}"
        result = run_engine("ps", "--all", "--filter", f"label={LABEL}=1", "--format", template, capture=True)
        rows = [line.split("\t", 2) for line in result.stdout.splitlines()]
        return [(name.removesuffix("-infra"), status, worktree) for name, status, worktree in rows
                if name.endswith("-infra")]

    def helper_log_args(self):
        return ["--log-driver", "none"]

    def app_log_args(self):
        return ["--log-driver", "json-file", "--log-opt", "max-size=10m", "--log-opt", "max-file=1"]

    def warnings(self):
        result = run_engine("info", "--format", "{{json .SecurityOptions}}", capture=True, check=False, quiet=True)
        if result.returncode or "name=rootless" in result.stdout:
            return []
        return ["the Docker daemon is not rootless. Its containers run as root on the host. See hc-sandbox.md."]


ENGINES = {engine.name: engine for engine in (Podman, Docker)}


@functools.cache
def docker_host():
    if os.environ.get("DOCKER_HOST"):
        return os.environ["DOCKER_HOST"]
    result = subprocess.run(["docker", "context", "inspect", "--format", "{{.Endpoints.docker.Host}}"],
                            stdin=subprocess.DEVNULL, capture_output=True, text=True)
    require(result.returncode == 0 and result.stdout.strip(), "cannot find the Docker daemon address")
    return result.stdout.strip()


def empty_docker_config():
    path = sandbox_runtime_dir() / "docker-config"
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    return path


def settings_file():
    config_home = os.environ.get("XDG_CONFIG_HOME") or str(home_dir() / ".config")
    return Path(config_home) / "hc" / "sandbox.toml"


def read_settings(path):
    try:
        data = tomllib.loads(path.read_text())
    except FileNotFoundError:
        return {}
    unknown = set(data) - SETTINGS_KEYS
    require(not unknown, f"unknown keys in {path}: {', '.join(sorted(unknown))}")
    return data


def engine_name():
    name = os.environ.get(ENGINE_VARIABLE) or read_settings(settings_file()).get("engine", "podman")
    require(name in ENGINES, f"engine must be one of {', '.join(ENGINES)}, not {name!r}")
    return name


@functools.cache
def engine():
    return ENGINES[engine_name()]()


def run_engine(*args, capture=False, check=True, quiet=False):
    result = subprocess.run(
        engine().argv(*args),
        env=engine().env(),
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE if capture or quiet else None,
        stderr=subprocess.PIPE if quiet else None,
        text=True,
    )
    if check and result.returncode:
        detail = (result.stderr or "").strip() if quiet else ""
        raise SandboxError(f"{engine().name} {args[0]} failed with exit code {result.returncode}. {detail}".strip())
    return result


def exists(kind, name):
    return run_engine(*engine().exists_args(kind, name), check=False, quiet=True).returncode == 0


def remove_container(name):
    run_engine(*engine().remove_args(name), check=False, quiet=True)


def host_networks(links):
    networks = set()
    for link in links:
        for info in link.get("addr_info", []):
            interface = ipaddress.ip_interface(f"{info['local']}/{info['prefixlen']}")
            global_ipv6 = interface.version == 6 and interface.ip in GLOBAL_IPV6
            networks.add(str(interface.network if global_ipv6 else interface.ip))
    return sorted(networks)


def host_addresses():
    result = subprocess.run(["ip", "-j", "addr"], capture_output=True, text=True, check=True)
    return host_networks(json.loads(result.stdout))


PASTA_NETWORK = "pasta:--no-map-gw"


def asset_tag(kind):
    digest = hashlib.sha256()
    for path in sorted(ASSETS.iterdir()):
        digest.update(path.name.encode() + b"\0" + path.read_bytes())
    return f"localhost/hc-sandbox/{kind}:{digest.hexdigest()[:12]}"


def asset_build_tail(kind, tag):
    return ["--label", f"{LABEL}=1", "--tag", tag, "--file", str(ASSETS / f"{kind}.Containerfile"), str(ASSETS)]


def cap_flags(caps):
    return [flag for cap in caps.split(",") for flag in ("--cap-add", cap)]


def builder_args(sandbox, builder_image):
    return ["run", "--rm", "--interactive", "--name", sandbox.builder, *sandbox.labels(), *engine().helper_log_args(),
            "--network", f"container:{sandbox.egress}", "--cap-drop", "all", *cap_flags(BUILDER_CAPS),
            "--security-opt", "no-new-privileges", *BUILDER_LIMITS,
            "--volume", f"{sandbox.store}:{BUILDER_STORE}", "--volume", f"{sandbox.cache}:/cache",
            builder_image, "sh", "-c", BUILD_SCRIPT, "build", STEP_CAPS, sandbox.config.containerfile, sandbox.image]


def ensure_volume(name):
    if not exists("volume", name):
        run_engine("volume", "create", "--label", f"{LABEL}=1", name, quiet=True)


def ensure_asset_image(kind):
    tag = asset_tag(kind)
    if not exists("image", tag):
        print(f"hc-sandbox: build the {kind} image", file=sys.stderr)
        run_engine(*engine().asset_build_args(kind, tag))
    return tag


def wait_until(check, timeout, interval=0.5):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if check():
            return True
        time.sleep(interval)
    return False


@contextlib.contextmanager
def egress_filter(sandbox):
    image = ensure_asset_image("egress")
    remove_container(sandbox.egress)
    run_engine("run", "--detach", "--name", sandbox.egress, *sandbox.labels(), *engine().egress_network_args(),
               *engine().helper_log_args(), "--dns-search", ".", *HARDENING, *LIMITS, "--entrypoint", "sleep", image, "infinity", quiet=True)
    try:
        run_engine("run", "--rm", *sandbox.labels(), "--network", f"container:{sandbox.egress}",
                   *engine().helper_log_args(), "--cap-drop", "all", "--cap-add", "NET_ADMIN", "--security-opt", "no-new-privileges", *LIMITS, image,
                   *host_addresses(), quiet=True)
        yield
    finally:
        remove_container(sandbox.egress)


def tar_info(name, status, kind):
    info = tarfile.TarInfo(name)
    info.type = kind
    info.mode = stat.S_IMODE(status.st_mode)
    info.mtime = int(status.st_mtime)
    return info


def add_tree(archive, dir_fd, prefix=""):
    for name in sorted(os.listdir(dir_fd)):
        if not prefix and name == STATE_DIR:
            continue
        status = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
        if stat.S_ISDIR(status.st_mode):
            child = os.open(name, OPEN_DIR, dir_fd=dir_fd)
            try:
                archive.addfile(tar_info(prefix + name, status, tarfile.DIRTYPE))
                add_tree(archive, child, f"{prefix}{name}/")
            finally:
                os.close(child)
        elif stat.S_ISREG(status.st_mode):
            with os.fdopen(os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dir_fd), "rb") as handle:
                info = tar_info(prefix + name, os.fstat(handle.fileno()), tarfile.REGTYPE)
                info.size = os.fstat(handle.fileno()).st_size
                archive.addfile(info, handle)
        elif stat.S_ISLNK(status.st_mode):
            info = tar_info(prefix + name, status, tarfile.SYMTYPE)
            info.linkname = os.readlink(name, dir_fd=dir_fd)
            archive.addfile(info)


def write_context(worktree_fd, stream):
    with tarfile.open(fileobj=stream, mode="w|") as archive:
        add_tree(archive, worktree_fd)


def run_builder(sandbox, builder_image):
    builder = subprocess.Popen(engine().argv(*builder_args(sandbox, builder_image)), env=engine().env(),
                               stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    loader = subprocess.Popen(engine().argv("load"), env=engine().env(), stdin=builder.stdout,
                              stdout=subprocess.PIPE, text=True)
    builder.stdout.close()
    with contextlib.suppress(BrokenPipeError):
        write_context(sandbox.fd, builder.stdin)
    with contextlib.suppress(BrokenPipeError):
        builder.stdin.close()
    loader.communicate()
    require(builder.wait() == 0, f"the build failed with exit code {builder.returncode}")
    require(loader.returncode == 0 and exists("image", sandbox.image), f"{engine().name} load gave no image")


def build(sandbox):
    ensure_volume(sandbox.cache)
    ensure_volume(sandbox.store)
    builder_image = ensure_asset_image("builder")
    ensure_asset_image("browser")
    with egress_filter(sandbox):
        run_builder(sandbox, builder_image)
    print(f"hc-sandbox: built {sandbox.image}")


def open_child_dir(parent_fd, name):
    with contextlib.suppress(FileExistsError):
        os.mkdir(name, 0o755, dir_fd=parent_fd)
    try:
        return os.open(name, OPEN_DIR, dir_fd=parent_fd)
    except OSError as error:
        raise SandboxError(f"{name} must be a folder, not a link: {error.strerror}") from None


def write_new_file(dir_fd, name, text):
    try:
        fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644, dir_fd=dir_fd)
    except FileExistsError:
        return
    with os.fdopen(fd, "w") as handle:
        handle.write(text)


def write_file(dir_fd, name, data):
    with contextlib.suppress(FileNotFoundError):
        os.unlink(name, dir_fd=dir_fd)
    fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644, dir_fd=dir_fd)
    with os.fdopen(fd, "wb") as handle:
        handle.write(data)


def open_out_dir(sandbox):
    state_fd = open_child_dir(sandbox.fd, STATE_DIR)
    try:
        write_new_file(state_fd, ".gitignore", "*\n")
        return open_child_dir(state_fd, "out")
    finally:
        os.close(state_fd)


def copy_screenshot(sandbox, name):
    result = subprocess.run(engine().argv("exec", sandbox.browser, "cat", f"/tmp/{name}"), env=engine().env(),
                            capture_output=True)
    if result.returncode or not result.stdout:
        return False
    out_fd = open_out_dir(sandbox)
    try:
        write_file(out_fd, name, result.stdout)
    finally:
        os.close(out_fd)
    return True


def published_port(sandbox):
    result = run_engine("port", sandbox.app, f"{sandbox.config.port}/tcp", capture=True, check=False)
    return result.stdout.strip().rsplit(":", 1)[-1] if result.returncode == 0 and result.stdout.strip() else None


def app_url(sandbox, path):
    return f"http://{sandbox.pod}:{sandbox.config.port}{path}"


def app_ready(sandbox):
    return run_engine("exec", sandbox.browser, "wget", "-q", "-T", "2", "-O", "/dev/null",
                  app_url(sandbox, sandbox.config.ready_path), check=False, quiet=True).returncode == 0


def app_running(sandbox):
    result = run_engine("inspect", "--format", "{{.State.Running}}", sandbox.app, check=False, quiet=True)
    return result.returncode == 0 and result.stdout.strip() == "true"


def down(sandbox, announce=True):
    engine().remove_run_network(sandbox)
    remove_container(sandbox.egress)
    remove_container(sandbox.builder)
    if announce:
        print(f"hc-sandbox: {sandbox.pod} is down")


def up(sandbox, publish):
    require(exists("image", sandbox.image), "no image: run hc-sandbox build first")
    browser_image = asset_tag("browser")
    require(exists("image", browser_image), "no browser image: run hc-sandbox build first")
    require(not publish or sandbox.config.port, "--publish needs a port in the config")
    down(sandbox, announce=False)
    ensure_volume(sandbox.cache)
    os.close(open_out_dir(sandbox))
    ports = ["--publish", f"127.0.0.1::{sandbox.config.port}"] if publish else []
    app_network, browser_network = engine().create_run_network(sandbox, ports)
    run_engine("run", "--detach", *app_network, "--name", sandbox.app, *sandbox.labels(), *HARDENING, *LIMITS,
               *engine().app_log_args(), "--volume", f"{sandbox.cache}:/cache", sandbox.image, quiet=True)
    run_engine("run", "--detach", *browser_network, "--name", sandbox.browser, *sandbox.labels(), *HARDENING,
               *LIMITS, *engine().helper_log_args(), "--entrypoint", "sleep", browser_image, "infinity", quiet=True)
    if sandbox.config.port:
        ready = wait_until(lambda: app_ready(sandbox) or not app_running(sandbox), sandbox.config.ready_timeout)
        require(ready and app_running(sandbox), "the app did not answer on its port: run hc-sandbox logs")
    print(f"hc-sandbox: {sandbox.pod} is up")
    if publish:
        print(f"hc-sandbox: open http://127.0.0.1:{published_port(sandbox)}{sandbox.config.ready_path}")


def page_slug(path):
    slug = re.sub(r"[^A-Za-z0-9]+", "-", path).strip("-")
    return slug or "index"


def check_page(sandbox, page):
    screenshot = f"{page_slug(page.path)}.png"
    url = app_url(sandbox, page.path)
    shot = run_engine("exec", sandbox.browser, *BROWSER, f"--screenshot=/tmp/{screenshot}", url,
                      check=False, quiet=True)
    dom = run_engine("exec", sandbox.browser, *BROWSER, "--dump-dom", url, check=False, quiet=True)
    if shot.returncode or dom.returncode or not copy_screenshot(sandbox, screenshot):
        return f"{page.path}: the browser failed"
    if page.expect not in dom.stdout:
        return f"{page.path}: the page does not contain {page.expect!r}"
    print(f"hc-sandbox: pass {page.path}, screenshot {sandbox.out / screenshot}")
    return None


def test(sandbox):
    require(app_running(sandbox), "the app is not running: run hc-sandbox up")
    failures = []
    if sandbox.config.test_command:
        if run_engine("exec", sandbox.app, *sandbox.config.test_command, check=False).returncode:
            failures.append("test_command failed")
    for page in sandbox.config.pages:
        failure = check_page(sandbox, page)
        if failure:
            failures.append(failure)
    for failure in failures:
        print(f"hc-sandbox: FAIL {failure}", file=sys.stderr)
    print(f"hc-sandbox: {'FAIL' if failures else 'PASS'}")
    return 1 if failures else 0


def exec_command(sandbox, command):
    require(command, "give a command after --")
    require(app_running(sandbox), "the app is not running: run hc-sandbox up")
    interactive = ["--interactive", "--tty"] if sys.stdin.isatty() and sys.stdout.isatty() else []
    return subprocess.run(engine().argv("exec", *interactive, sandbox.app, *command), env=engine().env()).returncode


def logs(sandbox, tail):
    return run_engine("logs", "--tail", str(tail), sandbox.app, check=False).returncode


def list_sandboxes():
    for name, status, worktree in engine().list_sandboxes():
        print(f"{name}\t{status}\t{worktree}")
    return 0


def parse_args(argv):
    parser = argparse.ArgumentParser(prog="hc-sandbox", description="Build, run, and test a worktree in Podman or Docker.",
                                     epilog=CONFIG_HELP, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("-C", dest="directory", default=".", help="start the search for hc-sandbox.toml here")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("build", help="build the image from the worktree")
    up_parser = commands.add_parser("up", help="start the pod on an internal network")
    up_parser.add_argument("--publish", action="store_true", help="publish the app port on 127.0.0.1")
    commands.add_parser("test", help="run test_command and the browser checks")
    exec_parser = commands.add_parser("exec", help="run a command in the app container")
    exec_parser.add_argument("argv", nargs=argparse.REMAINDER)
    logs_parser = commands.add_parser("logs", help="show the app logs")
    logs_parser.add_argument("--tail", type=int, default=200)
    commands.add_parser("down", help="remove the pod and its network")
    commands.add_parser("ls", help="list sandboxes")
    return parser.parse_args(argv)


def warn_about_engine():
    for warning in engine().warnings():
        print(f"hc-sandbox: warning: {warning}", file=sys.stderr)


def run(args):
    warn_about_engine()
    if args.command == "ls":
        return list_sandboxes()
    worktree_fd, worktree = open_worktree(find_worktree(Path(args.directory).resolve()), worktrees_root())
    try:
        return run_command(args, Sandbox(worktree, load_config(worktree_fd), worktree_fd))
    finally:
        os.close(worktree_fd)


def run_command(args, sandbox):
    if args.command == "build":
        build(sandbox)
    elif args.command == "up":
        up(sandbox, args.publish)
    elif args.command == "test":
        return test(sandbox)
    elif args.command == "exec":
        command = args.argv[1:] if args.argv[:1] == ["--"] else args.argv
        return exec_command(sandbox, command)
    elif args.command == "logs":
        return logs(sandbox, args.tail)
    elif args.command == "down":
        down(sandbox)
    return 0


def main(argv=None):
    try:
        return run(parse_args(sys.argv[1:] if argv is None else argv))
    except SandboxError as error:
        print(f"hc-sandbox: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
