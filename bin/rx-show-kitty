#!/usr/bin/env python3

import base64
from pathlib import Path
import shutil
import subprocess
import sys


def show(path):
    if path.suffix.lower() == ".png":
        data = path.read_bytes()
    else:
        data = subprocess.run(
            ["magick", f"{path}[0]", "png:-"], check=True, stdout=subprocess.PIPE
        ).stdout
    payload = base64.standard_b64encode(data)
    columns = shutil.get_terminal_size().columns
    for start in range(0, len(payload), 4096):
        part = payload[start:start + 4096]
        more = int(start + 4096 < len(payload))
        keys = f"f=100,a=T,c={columns}," if start == 0 else ""
        sys.stdout.buffer.write(
            b"\x1b_G" + f"{keys}m={more}".encode() + b";" + part + b"\x1b\\"
        )
    sys.stdout.buffer.write(b"\n")
    sys.stdout.flush()


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit("Usage: rx-show-kitty <image>")
    show(Path(sys.argv[1]).resolve())
