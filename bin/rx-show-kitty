#!/usr/bin/env python3

import base64
import fcntl
import os
from pathlib import Path
import signal
import struct
import sys
import termios


def pane_size():
    try:
        rows, columns, width, height = struct.unpack(
            "HHHH", fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, bytes(8))
        )
        if rows and columns:
            return rows, columns, width, height
    except OSError:
        pass
    try:
        columns, rows = os.get_terminal_size(sys.stdout.fileno())
    except OSError:
        columns, rows = 80, 24
    return rows, columns, 0, 0


def image_size_key(data, pane):
    if data[:8] != b"\x89PNG\r\n\x1a\n" or data[12:16] != b"IHDR":
        raise ValueError("invalid PNG")
    width, height = struct.unpack(">II", data[16:24])
    if not width or not height:
        raise ValueError("invalid PNG size")
    rows, columns, pixels_wide, pixels_high = pane
    if pixels_wide < columns or pixels_high < rows:
        return f"c={columns}," if width > columns * 8 else ""
    if width <= pixels_wide and height <= pixels_high:
        return ""
    if width * pixels_high >= height * pixels_wide:
        return f"c={columns},"
    return f"r={rows},"


def draw(data, payload):
    size_key = image_size_key(data, pane_size())
    sys.stdout.buffer.write(b"\x1b[?25l\x1b[2J\x1b[H")
    for start in range(0, len(payload), 4096):
        part = payload[start:start + 4096]
        more = int(start + 4096 < len(payload))
        keys = f"f=100,a=T,C=1,{size_key}" if start == 0 else ""
        sys.stdout.buffer.write(
            b"\x1b_G" + f"{keys}m={more}".encode() + b";" + part + b"\x1b\\"
        )
    sys.stdout.flush()


def show(path, remove=False):
    try:
        data = path.read_bytes()
    finally:
        if remove:
            path.unlink(missing_ok=True)
    payload = base64.standard_b64encode(data)
    signal.signal(signal.SIGWINCH, lambda *_: None)
    wait_signals = {signal.SIGWINCH, signal.SIGINT}
    signal.pthread_sigmask(signal.SIG_BLOCK, wait_signals)
    draw(data, payload)
    if not sys.stdout.isatty():
        return
    while True:
        if signal.sigwait(wait_signals) == signal.SIGINT:
            sys.stdout.buffer.write(b"\x1b[?25h")
            sys.stdout.flush()
            return
        sys.stdout.buffer.write(b"\x1b_Ga=d,d=A\x1b\\")
        draw(data, payload)


if __name__ == "__main__":
    args = sys.argv[1:]
    remove = args[:1] == ["--remove"]
    if remove:
        args = args[1:]
    if len(args) != 1:
        sys.exit("Usage: rx-show-kitty [--remove] <PNG>")
    try:
        show(Path(args[0]), remove)
    except KeyboardInterrupt:
        pass
    except (OSError, ValueError, struct.error):
        sys.exit("rx-show-kitty: could not display the PNG")
