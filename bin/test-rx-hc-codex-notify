#!/usr/bin/env python3

import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import unittest


class NotifyTests(unittest.TestCase):
    def setUp(self):
        folder = tempfile.TemporaryDirectory()
        self.addCleanup(folder.cleanup)
        self.root = Path(folder.name)
        self.bin = self.root / "bin"
        self.bin.mkdir()
        self.path = self.root / "path"
        self.path.mkdir()
        self.home = self.root / "home"
        self.local_bin = self.home / ".local/bin"
        self.local_bin.mkdir(parents=True)
        self.wrapper = self.bin / "rx-hc-codex-notify"
        shutil.copy2(Path(__file__).with_name(self.wrapper.name), self.wrapper)
        self.env = {
            **os.environ, "HOME": str(self.home),
            "PATH": str(self.path), "NOTIFY_TEST": "sample",
        }

    def hook(self, legacy=False, code=0, peer=None):
        name = "hc-codex-notify" if legacy else "rx-codex-notify"
        target = (self.path if legacy else self.bin) / name
        target.write_text(
            "#!/usr/bin/python3\n"
            "import json, os, sys, time\n"
            "from pathlib import Path\n"
            f"name = {name!r}\n"
            "Path(name).write_text(json.dumps([sys.argv[1:], os.environ['NOTIFY_TEST']]))\n"
            "print(name + ':out', flush=True)\n"
            "print(name + ':err', file=sys.stderr, flush=True)\n"
            + (f"deadline = time.monotonic() + 2\n"
               f"while not Path({peer!r}).exists() and time.monotonic() < deadline:\n"
               "    time.sleep(0.01)\n"
               f"print(name + ':peer=' + str(Path({peer!r}).exists()), flush=True)\n"
               if peer else "")
            + f"sys.exit({code})\n"
        )
        target.chmod(0o755)
        return target

    def run_wrapper(self, args=(), wrapper=None):
        result = subprocess.run(
            [str(wrapper or self.wrapper), *args], cwd=self.root,
            env=self.env, capture_output=True, text=True, timeout=5,
        )
        self.assertEqual(result.returncode, 0, result.stderr)
        return result

    def test_arguments_environment_and_output(self):
        self.hook()
        self.hook(legacy=True)
        args = ['{"type":"agent-turn-complete","text":"你好"}', "", "a b\nc", "'\"$*", "--flag"]
        result = self.run_wrapper(args)
        for name in ("rx-codex-notify", "hc-codex-notify"):
            self.assertEqual(json.loads((self.root / name).read_text()), [args, "sample"])
            self.assertIn(name + ":out\n", result.stdout)
            self.assertIn(name + ":err\n", result.stderr)

    def test_missing_legacy_and_no_arguments(self):
        self.hook()
        result = self.run_wrapper()
        self.assertEqual(result.stdout, "rx-codex-notify:out\n")
        self.assertEqual(result.stderr, "rx-codex-notify:err\n")
        self.assertEqual(json.loads((self.root / "rx-codex-notify").read_text())[0], [])

    def test_child_failures(self):
        self.hook(code=17)
        self.hook(legacy=True, code=23)
        result = self.run_wrapper()
        self.assertIn("rx-codex-notify:out", result.stdout)
        self.assertIn("hc-codex-notify:out", result.stdout)

    def test_legacy_home_fallback(self):
        self.hook()
        hook = self.hook(legacy=True)
        hook.rename(self.local_bin / hook.name)
        self.assertNotIn(str(self.local_bin), self.env["PATH"].split(os.pathsep))
        args = ["fallback payload"]
        result = self.run_wrapper(args)
        self.assertIn("hc-codex-notify:out", result.stdout)
        self.assertEqual(
            json.loads((self.root / "hc-codex-notify").read_text()),
            [args, "sample"],
        )

    def test_legacy_home_fallback_not_executable(self):
        self.hook()
        hook = self.hook(legacy=True)
        fallback = hook.rename(self.local_bin / hook.name)
        fallback.chmod(0o644)
        result = self.run_wrapper()
        self.assertEqual(result.stdout, "rx-codex-notify:out\n")
        self.assertFalse((self.root / "hc-codex-notify").exists())

    def test_legacy_path_takes_precedence(self):
        self.hook(legacy=True).rename(self.local_bin / "hc-codex-notify")
        hook = self.hook(legacy=True)
        hook.write_text("#!/usr/bin/python3\nprint('path hook')\n")
        self.assertEqual(self.run_wrapper().stdout, "path hook\n")

    def test_legacy_launch_error(self):
        self.hook()
        hook = self.hook(legacy=True)
        hook.write_text("invalid executable\n")
        result = self.run_wrapper()
        self.assertEqual(result.stdout, "rx-codex-notify:out\n")
        self.assertEqual(result.stderr, "rx-codex-notify:err\n")

    def test_launch_errors(self):
        self.hook(legacy=True)
        for mode in (None, 0o644, 0o755):
            with self.subTest(mode=mode):
                if mode is not None:
                    target = self.bin / "rx-codex-notify"
                    target.write_text("invalid executable\n")
                    target.chmod(mode)
                self.assertIn("hc-codex-notify:out", self.run_wrapper().stdout)

    def test_missing_both(self):
        result = self.run_wrapper()
        self.assertEqual((result.stdout, result.stderr), ("", ""))

    def test_symbolic_link(self):
        self.hook()
        link = self.path / self.wrapper.name
        link.symlink_to(self.wrapper)
        self.assertIn("rx-codex-notify:out", self.run_wrapper(wrapper=link).stdout)

    def test_children_start_before_wait(self):
        self.hook(peer="hc-codex-notify")
        self.hook(legacy=True, peer="rx-codex-notify")
        result = self.run_wrapper()
        self.assertIn("rx-codex-notify:peer=True", result.stdout)
        self.assertIn("hc-codex-notify:peer=True", result.stdout)


if __name__ == "__main__":
    unittest.main()
