#!/usr/bin/python3

from fnmatch import fnmatchcase
import json
import os
from pathlib import Path
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
try:
    from hc_label import label_value
except Exception:
    label_value = None


REASON = "Do not edit files in the repo. Send this change to the build worker."


def in_worktree(path):
    for parent in path.parents:
        if (parent / ".git").exists():
            env = {
                key: value for key, value in os.environ.items()
                if not key.startswith("GIT_")
            }
            result = subprocess.run(
                ["/usr/bin/git", "-C", str(parent),
                 "rev-parse", "--is-inside-work-tree"],
                capture_output=True, text=True, timeout=2, env=env,
            )
            if result.returncode == 0 and result.stdout.strip() == "true":
                return True
    return False


def state_file(path):
    base = os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state"
    root = Path(base) / "hc"
    lexical_root = Path(os.path.abspath(root))
    return path.name == "state.md" and (
        path.is_relative_to(lexical_root) or path.is_relative_to(root.resolve())
    )


def allow_file():
    base = Path(os.environ.get("XDG_CONFIG_HOME") or ".")
    if not base.is_absolute():
        base = Path.home() / ".config"
    return Path(os.path.abspath(Path(base) / "hc/owner-guard-allow"))


def allowed_path(lexical, resolved, config):
    try:
        lines = config.read_text().splitlines()
    except (OSError, UnicodeError):
        return False
    globs = []
    for line in lines:
        pattern = line.strip()
        if not pattern or pattern.startswith("#"):
            continue
        if pattern.startswith("~/"):
            pattern = str(Path.home()) + pattern[1:]
        if not Path(pattern).is_absolute():
            continue
        globs.append(Path(pattern).parts)
    return all(
        any(
            len(target.parts) == len(parts) and all(
                fnmatchcase(part, glob) for part, glob in zip(target.parts, parts)
            )
            for parts in globs
        )
        for target in (lexical, resolved)
    )


def denial():
    return {"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": REASON,
    }}


def decision(payload):
    if not isinstance(payload, dict):
        return None
    if payload.get("hook_event_name") != "PreToolUse":
        return None
    field = {
        "Edit": "file_path", "Write": "file_path",
        "NotebookEdit": "notebook_path",
    }.get(payload.get("tool_name"))
    terminal = os.environ.get("HC_TERMINAL_ID")
    if field is None or not terminal or label_value is None:
        return None
    if label_value(terminal, "role") != "orchestrator":
        return None
    inputs = payload.get("tool_input")
    target = inputs.get(field) if isinstance(inputs, dict) else None
    if not isinstance(target, str) or not target:
        return None
    if target == "~" or target.startswith("~/"):
        target = os.path.expanduser(target)
    path = Path(target)
    if not path.is_absolute():
        path = Path(payload.get("cwd") or os.getcwd()) / path
    lexical = Path(os.path.abspath(path))
    resolved = path.resolve()
    config = allow_file()
    if {lexical, resolved} & {config, config.resolve()}:
        return denial()
    if allowed_path(lexical, resolved, config):
        return None
    if state_file(lexical) and state_file(resolved):
        return None
    if in_worktree(lexical) or in_worktree(resolved):
        return denial()
    return None


def main():
    try:
        raw = sys.stdin.read()
        result = decision(json.loads(raw))
        if result:
            print(json.dumps(result))
    except (OSError, ValueError, TypeError, UnicodeError, RuntimeError,
            RecursionError, subprocess.TimeoutExpired):
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
