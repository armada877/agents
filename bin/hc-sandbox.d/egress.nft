table inet hc_sandbox {
  set host4 { type ipv4_addr; }
  set host6 { type ipv6_addr; }
  chain out {
    type filter hook output priority 0; policy accept;
    ip daddr 169.254.1.1 meta l4proto { tcp, udp } th dport 53 accept
    ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/3 } reject
    ip daddr @host4 reject
    meta nfproto ipv6 ip6 daddr != 2000::/3 reject
    ip6 daddr @host6 reject
  }
}
