#!/usr/bin/env python3

import json
import subprocess
import sys
import unicodedata


def run_json(command):
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode:
        text = " ".join(command)
        raise ValueError(result.stderr.strip() or f"{text} failed")
    try:
        return json.loads(result.stdout)
    except ValueError:
        raise ValueError(f"{' '.join(command)} gave invalid JSON") from None


def clean(text):
    return "".join(
        " " if unicodedata.category(char).startswith("C") else char
        for char in str(text)
    )


def terminal_ids():
    listing = run_json(["hc", "ls", "--json"])
    items = listing.get("terminals", [])
    ids = [item.get("name") or item.get("address") for item in items]
    return [identifier for identifier in ids if identifier]


def decision_line(identifier):
    labels = run_json(["hc", "get", identifier, "--json"]).get("labels") or {}
    decision = labels.get("decision")
    if not decision:
        return None
    is_decision = labels.get("decision-kind") == "decision"
    kind = "decision" if is_decision else "approval"
    fields = [clean(identifier), clean(kind), clean(decision)[:200]]
    return "\t".join(fields)


def main():
    try:
        identifiers = terminal_ids()
    except ValueError as error:
        print(f"hc-decisions: {str(error).splitlines()[0]}", file=sys.stderr)
        return 1
    lines = []
    unread = 0
    for identifier in sorted(identifiers):
        try:
            line = decision_line(identifier)
        except ValueError:
            unread += 1
            continue
        if line:
            lines.append(line)
    if lines:
        print("\n".join(lines))
    if unread:
        print(f"{unread} terminals could not be read")
    if not lines and not unread:
        print("no open decisions")
    return 0


if __name__ == "__main__":
    sys.exit(main())
