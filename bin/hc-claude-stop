#!/usr/bin/python3

import json
import os
import sys
from pathlib import Path


sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
try:
    from hc_question import direct_question
except Exception:
    direct_question = None
try:
    from hc_label import decision_pending
except Exception:
    decision_pending = None


MAX_INPUT = 1024 * 1024
MAX_TRANSCRIPT = 16 * 1024 * 1024


def has_dialog(path):
    count = 0
    boundary = False
    with Path(path).open(encoding="utf-8") as stream:
        text = stream.read(MAX_TRANSCRIPT + 1)
    if len(text) > MAX_TRANSCRIPT:
        raise ValueError("transcript exceeds limit")
    for line in text.splitlines():
        entry = json.loads(line)
        if not isinstance(entry, dict):
            raise ValueError("invalid transcript entry")
        message = entry.get("message", {})
        if not isinstance(message, dict):
            continue
        content = message.get("content", [])
        if entry.get("type") == "user" and not entry.get("isMeta") and not entry.get("isCompactSummary"):
            actual = isinstance(content, str) and bool(content.strip())
            if isinstance(content, list):
                actual = any(isinstance(item, dict) and item.get("type") == "text" and isinstance(item.get("text"), str) and item["text"].strip() for item in content)
            if actual:
                count = 0
                boundary = True
        if boundary and entry.get("type") == "assistant" and isinstance(content, list):
            count += sum(isinstance(item, dict) and item.get("type") == "tool_use" and item.get("name") == "AskUserQuestion" for item in content)
    if not boundary:
        raise ValueError("no user boundary")
    return count > 0


QUESTION_REASON = "Ask the user with AskUserQuestion. Put all open questions in one dialog. If no answer is needed, state the result."
LABEL_REASON = (
    "Your decision label is set, but you showed the user no dialog. "
    "Ask the user with AskUserQuestion. Put all open questions in one dialog. "
    "If you need no answer, clear the label with: hc label \"$HC_TERMINAL_ID\" decision= decision-kind="
)


def asks_question(text):
    return direct_question is not None and isinstance(text, str) and direct_question(text)


def labeled():
    terminal = os.environ.get("HC_TERMINAL_ID")
    return bool(terminal) and decision_pending is not None and decision_pending(terminal)


def decision(payload):
    if not isinstance(payload, dict) or payload.get("hook_event_name") != "Stop":
        return None
    if payload.get("stop_hook_active") is not False:
        return None
    if asks_question(payload.get("last_assistant_message")):
        reason = QUESTION_REASON
    elif labeled():
        reason = LABEL_REASON
    else:
        return None
    if has_dialog(payload.get("transcript_path")):
        return None
    return {"decision": "block", "reason": reason}


def main():
    try:
        raw = sys.stdin.read(MAX_INPUT + 1)
        if len(raw) > MAX_INPUT:
            return 0
        result = decision(json.loads(raw))
        if result:
            print(json.dumps(result))
    except (OSError, ValueError, TypeError, UnicodeError):
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
