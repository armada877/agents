#!/usr/bin/python3

import json
import os
import sys
from pathlib import Path


sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
try:
    from hc_question import direct_question
except Exception:
    direct_question = None
try:
    from hc_label import decision_pending
except Exception:
    def decision_pending(terminal):
        return False


BLOCKED = b"\x1b]7501;state=blocked\x1b\\"


def question_pending():
    if len(sys.argv) != 2:
        return False
    try:
        payload = json.loads(sys.argv[1])
    except (ValueError, RecursionError):
        return False
    if not isinstance(payload, dict) or payload.get("type") != "agent-turn-complete":
        return False
    text = payload.get("last-assistant-message")
    return direct_question is not None and isinstance(text, str) and direct_question(text)


def main():
    terminal = os.environ.get("HC_TERMINAL_ID")
    if not terminal:
        return 0
    labeled = decision_pending(terminal)
    if not question_pending() and not labeled:
        return 0
    try:
        with open("/dev/tty", "wb", buffering=0) as stream:
            stream.write(BLOCKED)
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
