#!/usr/bin/env python3

from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
import sys
import unittest
from types import SimpleNamespace
from unittest.mock import patch

sys.dont_write_bytecode = True

loader = SourceFileLoader("hc_send", str(Path(__file__).with_name("hc-send")))
module = module_from_spec(spec_from_loader(loader.name, loader))
loader.exec_module(module)


class InputTests(unittest.TestCase):
    def test_codex_placeholders_are_empty(self):
        for text in ("Ask Codex to do anything", "Ask a follow-up question"):
            with self.subTest(text=text):
                self.assertTrue(module.input_is_empty(f"output\n› {text}\nstatus"))

    def test_codex_typed_text(self):
        self.assertFalse(module.input_is_empty("› typed text\nstatus"))

    def test_text_starting_with_placeholder_is_typed(self):
        self.assertFalse(module.input_is_empty("› Ask Codex to do anything please\nstatus"))

    def test_last_input_line_is_used(self):
        older_placeholder = "› Ask Codex to do anything\n› typed text\nstatus"
        older_typed = "› typed text\n› Ask Codex to do anything\nstatus"
        self.assertFalse(module.input_is_empty(older_placeholder))
        self.assertTrue(module.input_is_empty(older_typed))

    def test_claude_empty(self):
        self.assertTrue(module.input_is_empty("❯ previous\n❯  \nstatus"))
        self.assertTrue(module.input_is_empty('❯ Try "fix the bug"\nstatus'))

    def test_claude_typed(self):
        self.assertFalse(module.input_is_empty("❯ typed text\nstatus"))

    def test_no_input_line(self):
        self.assertFalse(module.input_is_empty("output only\nstatus"))


class SendTests(unittest.TestCase):
    def test_sends_after_two_ready_checks(self):
        args = SimpleNamespace(terminal="worker", text="task", timeout=600000, interval=2)
        with (
            patch.object(module, "status_of", side_effect=["idle", "idle"]) as status,
            patch.object(module, "input_empty", return_value=True),
            patch.object(module.time, "sleep") as sleep,
            patch.object(module.subprocess, "run") as run,
        ):
            run.return_value.returncode = 7
            self.assertEqual(module.send_when_ready(args), 7)
        self.assertEqual(status.call_count, 2)
        sleep.assert_called_once()
        run.assert_called_once_with(["hc", "send", "worker", "task"])

    def test_timeout_returns_2_without_send(self):
        args = SimpleNamespace(terminal="worker", text="task", timeout=5000, interval=2)
        clock = iter([0, 1, 3, 5, 7, 9, 11])
        with (
            patch.object(module, "status_of", return_value="working"),
            patch.object(module.time, "monotonic", side_effect=lambda: next(clock)),
            patch.object(module.time, "sleep"),
            patch.object(module.subprocess, "run") as run,
        ):
            self.assertEqual(module.send_when_ready(args), 2)
        run.assert_not_called()


class MainTests(unittest.TestCase):
    def test_default_timeout(self):
        with (
            patch.object(sys, "argv", ["hc-send", "worker", "task"]),
            patch.object(module, "send_when_ready", return_value=0) as send,
        ):
            self.assertEqual(module.main(), 0)
        self.assertEqual(send.call_args.args[0].timeout, 600000)


if __name__ == "__main__":
    unittest.main()
