#!/usr/bin/env python3

import argparse
import difflib
import json
from pathlib import Path
import re
import subprocess
import sys

RULE_PREFIX = "Standing merge class"
FIELDS = "state,baseRefName,headRefOid,files"
ALLOWED_PREFIX = "skills/"
DENIED_PREFIX = "skills/security-supervisor/"
HEADING = re.compile(r"^#{1,6} ")
SENSITIVE_LINE = re.compile(
    r"approv|accepted risk|wider access|permission|merge|deploy|sudo"
    r"|secret|credential",
    re.IGNORECASE,
)
PROTECTED_HEADINGS = (
    "Decide, then report",
    "Small change",
    "The user's text",
    "Open decisions",
    "Review rounds",
    "Deploy approval",
    "Limits on messages",
    "Review and integrate",
    "Standing merge class",
    "Plans for <user name>'s approval",
    "Valid relay",
    "Delete a merged remote branch",
)


class CheckError(Exception):
    pass


def run(command):
    try:
        result = subprocess.run(command, capture_output=True, text=True)
    except OSError as error:
        raise CheckError(f"{command[0]} failed: {error}") from None
    if result.returncode:
        lines = result.stderr.strip().splitlines()
        detail = lines[0] if lines else f"exit {result.returncode}"
        raise CheckError(f"{' '.join(command[:2])} failed: {detail}")
    return result.stdout


def read_settings():
    return json.loads((Path.home() / ".claude/settings.json").read_text())


def check_rule():
    try:
        rules = read_settings()["autoMode"]["allow"]
    except (OSError, ValueError, KeyError, TypeError):
        return ["no readable autoMode.allow in settings"]
    if not isinstance(rules, list) or not any(
        isinstance(rule, str) and rule.startswith(RULE_PREFIX)
        for rule in rules
    ):
        return [f"no autoMode.allow rule starts with {RULE_PREFIX}"]
    return []


def pull_request(pr):
    try:
        data = json.loads(run(["gh", "pr", "view", pr, "--json", FIELDS]))
        paths = [str(item["path"]) for item in data["files"]]
        return (
            str(data["state"]),
            str(data["baseRefName"]),
            str(data["headRefOid"]),
            paths,
        )
    except (ValueError, KeyError, TypeError):
        raise CheckError("pull request data is not valid") from None


def check_pull_request(pr, head):
    state, base, oid, paths = pull_request(pr)
    reasons = []
    if state != "OPEN":
        reasons.append(f"pull request state is {state}, not OPEN")
    if base != "main":
        reasons.append(f"base branch is {base}, not main")
    if oid != head:
        reasons.append(f"head is {oid}, not {head}")
    return reasons, paths


def check_paths(paths):
    reasons = []
    if not paths:
        reasons.append("pull request has no files")
    for path in paths:
        if not path.startswith(ALLOWED_PREFIX):
            reasons.append(f"path outside skills/: {path}")
        elif path.startswith(DENIED_PREFIX):
            reasons.append(f"path under {DENIED_PREFIX}: {path}")
    return reasons


def sections(text):
    result = {}
    key = None
    for line in text.splitlines(keepends=True):
        if HEADING.match(line):
            key = line.lstrip("#").strip()
        result.setdefault(key, []).append(line)
    return {name: "".join(lines) for name, lines in result.items()}


def check_text(path, base_text, head_text):
    reasons = []
    base_sections = sections(base_text)
    head_sections = sections(head_text)
    for heading in PROTECTED_HEADINGS:
        if base_sections.get(heading) != head_sections.get(heading):
            reasons.append(f"protected section changed in {path}: {heading}")
    changes = difflib.unified_diff(
        base_text.splitlines(), head_text.splitlines(), lineterm="", n=0
    )
    for line in changes:
        if line.startswith(("+++", "---", "@@")):
            continue
        if SENSITIVE_LINE.search(line[1:]):
            reasons.append(f"sensitive line changed in {path}: {line}")
    return reasons


def check_files(head, paths):
    base = run(["git", "merge-base", "origin/main", head]).strip()
    reasons = []
    for path in paths:
        if not path.startswith(ALLOWED_PREFIX):
            continue
        try:
            base_text = run(["git", "show", f"{base}:{path}"])
            head_text = run(["git", "show", f"{head}:{path}"])
        except CheckError:
            reasons.append(f"file added or deleted: {path}")
            continue
        reasons.extend(check_text(path, base_text, head_text))
    return reasons


def check_head_is_local(head):
    try:
        run(["git", "rev-parse", "--verify", f"{head}^{{commit}}"])
    except CheckError:
        raise CheckError(f"head {head} is not local: run git fetch") from None


def all_reasons(pr, head):
    reasons = check_rule()
    try:
        pr_reasons, paths = check_pull_request(pr, head)
        reasons.extend(pr_reasons)
        reasons.extend(check_paths(paths))
        check_head_is_local(head)
        reasons.extend(check_files(head, paths))
    except CheckError as error:
        reasons.append(str(error))
    return reasons


def main():
    parser = argparse.ArgumentParser(
        description="Check that a pull request is in the standing merge class."
    )
    parser.add_argument("pr")
    parser.add_argument("--head", required=True)
    args = parser.parse_args()
    reasons = all_reasons(args.pr, args.head)
    if not reasons:
        print("PASS")
        return 0
    for reason in reasons:
        print(f"FAIL: {reason}")
    return 1


if __name__ == "__main__":
    sys.exit(main())
