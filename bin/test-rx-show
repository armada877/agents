#!/usr/bin/env python3

import base64
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import pty
import select
from pathlib import Path
import shutil
import struct
import subprocess
import tempfile
import termios
import time
import unittest
from unittest.mock import patch
import zlib

RX_SHOW = Path(__file__).resolve().with_name("rx-show")

RECORDER = """#!/bin/bash
printf '%s\\n' "$@" > "$RECORD_DIR/$(basename "$0")"
exit "${FAKE_EXIT:-0}"
"""


def png_data(width=640, height=384):
    def chunk(kind, data):
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data))
    return (
        b"\x89PNG\r\n\x1a\n"
        + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
        + chunk(b"IDAT", zlib.compress((b"\0" + b"\xff\0\0" * width) * height))
        + chunk(b"IEND", b"")
    )


REX_RECORDER = """#!/usr/bin/env python3
import json
import os
from pathlib import Path
import subprocess
import sys
root = Path(os.environ["RECORD_DIR"])
args = sys.argv[1:]
(root / "rex").write_text("\\n".join(args) + "\\n")
with (root / "rex-calls").open("a") as log:
    log.write(json.dumps(args) + "\\n")
if args[:2] == ["block", "close"] and os.environ.get("CLOSE_MISSING"):
    print("Error: block target not found", file=sys.stderr)
    sys.exit(3)
if os.environ.get("FAKE_EXIT") == "1" or args[0] == os.environ.get("FAIL_REX"):
    sys.exit(1)
if args[0] in ("run", "split"):
    if "--remove" in args:
        result = subprocess.run(args[args.index("--") + 1:], capture_output=True)
        (root / "kitty").write_bytes(result.stdout)
        if result.returncode:
            sys.exit(result.returncode)
    print("block:new")
"""

CONVERTER = """#!/usr/bin/env python3
import os
from pathlib import Path
import sys
root = Path(os.environ["RECORD_DIR"])
(root / "converter").write_text("\\n".join(sys.argv[1:]))
data = sys.stdin.buffer.read()
(root / "converter-input").write_bytes(data)
if data == b"bad":
    print("bad image details", file=sys.stderr)
    sys.exit(1)
sys.stdout.buffer.write((root / "converted.png").read_bytes())
"""


class RxShowTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.root = Path(self.temp.name).resolve()
        self.bin = self.root / "bin"
        self.records = self.root / "records"
        self.config = self.root / "config"
        for folder in (self.bin, self.records, self.config / "hc"):
            folder.mkdir(parents=True)
        for name in ("rex", "fake-push", "magick"):
            tool = self.bin / name
            tool.write_text({"rex": REX_RECORDER, "magick": CONVERTER}.get(name, RECORDER))
            tool.chmod(0o755)
        self.doc = self.root / "plan.md"
        self.doc.write_text("# Plan\n")
        self.image = self.root / "shot.PNG"
        self.image.write_bytes(png_data())
        (self.records / "converted.png").write_bytes(png_data())

    def tearDown(self):
        self.temp.cleanup()

    def set_push_command(self, text):
        (self.config / "hc" / "push-command").write_text(text)

    def run_show(self, *args, **env):
        full_env = {
            **os.environ,
            "PATH": f"{self.bin}:{os.environ['PATH']}",
            "RECORD_DIR": str(self.records),
            "XDG_CONFIG_HOME": str(self.config),
            "REX_BLOCK": "",
            "XDG_RUNTIME_DIR": str(self.root / "runtime"),
            **env,
        }
        return subprocess.run(
            [str(RX_SHOW), *args], env=full_env, capture_output=True, text=True
        )

    def recorded(self, name):
        path = self.records / name
        return path.read_text().splitlines() if path.exists() else None

    def test_markdown_opens_glow_and_pushes(self):
        self.set_push_command("# local push\n\nfake-push\n")
        result = self.run_show(str(self.doc))
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(
            self.recorded("rex"),
            ["run", "--focus=false", "--keep-open", "--label", "rx-show · plan.md", "--", "glow", "-t", str(self.doc)],
        )
        self.assertEqual(self.recorded("fake-push"), [str(self.doc)])
        self.assertIn("sent a push", result.stderr)

    def preview_state(self, caller="block:caller"):
        key = hashlib.sha256(caller.encode()).hexdigest()
        return self.root / "runtime" / "rx-show" / f"{key}.block"

    def set_preview(self, caller="block:caller", block="block:old"):
        state = self.preview_state(caller)
        state.parent.mkdir(parents=True, exist_ok=True)
        state.write_text(block + "\n")

    def calls(self):
        return [json.loads(line) for line in self.recorded("rex-calls") or []]

    def test_image_opens_kitty_tab_without_push(self):
        self.set_push_command("fake-push\n")
        result = self.run_show(str(self.image))
        self.assertEqual(result.returncode, 0, result.stderr)
        call = self.calls()[0]
        self.assertEqual(call[:-1], [
            "run", "--focus=false", "--keep-open", "--label", "shot.PNG preview",
            "--", str(RX_SHOW.with_name("rx-show-kitty")), "--remove",
        ])
        self.assertFalse(Path(call[-1]).exists())
        self.assertIsNone(self.recorded("fake-push"))
        self.assertIn("only Markdown", result.stderr)

    def test_images_with_different_names_replace_callers_preview(self):
        self.set_preview()
        for name in ("shot.PNG", "another.jpg"):
            source = self.root / name
            source.write_bytes(b"image")
            result = self.run_show(str(source), REX_BLOCK="block:caller")
            self.assertEqual(result.returncode, 0, result.stderr)
            self.assertIn("opened a split", result.stderr)
        calls = self.calls()
        self.assertEqual(calls[0], ["block", "close", "block:old"])
        self.assertEqual(calls[2], ["block", "close", "block:new"])
        self.assertEqual(calls[3][0:7], [
            "split", "-b", "block:caller", "--split=right", "--ratio", "60", "--focus=false",
        ])
        self.assertIn("another.jpg preview", calls[3])
        self.assertEqual(self.preview_state().read_text(), "block:new\n")

    def test_callers_do_not_close_each_others_preview(self):
        self.set_preview("block:other", "block:unrelated")
        result = self.run_show(str(self.image), REX_BLOCK="block:caller")
        self.assertIn("opened a split", result.stderr)
        self.assertEqual([call[0] for call in self.calls()], ["split"])
        self.assertEqual(self.preview_state("block:other").read_text(), "block:unrelated\n")

    def test_failed_close_preserves_state_and_stops(self):
        self.set_preview()
        result = self.run_show(str(self.image), REX_BLOCK="block:caller", FAIL_REX="block")
        self.assertEqual(self.calls(), [["block", "close", "block:old"]])
        self.assertEqual(result.stderr.splitlines(), ["rx-show: could not close the earlier preview"])
        self.assertEqual(self.preview_state().read_text(), "block:old\n")
        self.assertEqual(list(self.preview_state().parent.glob("image.*.png")), [])

    def test_missing_preview_record_is_replaced(self):
        self.set_preview()
        result = self.run_show(str(self.image), REX_BLOCK="block:caller", CLOSE_MISSING="1")
        self.assertIn("opened a split", result.stderr)
        self.assertEqual(self.calls()[0], ["block", "close", "block:old"])
        self.assertEqual(self.calls()[1][0], "split")
        self.assertEqual(self.preview_state().read_text(), "block:new\n")

    def test_failed_split_falls_back_to_tab(self):
        result = self.run_show(str(self.image), REX_BLOCK="block:stale", FAIL_REX="split")
        self.assertIn("opened a tab", result.stderr)
        self.assertEqual([call[0] for call in self.calls()], ["split", "run"])
        self.assertEqual(self.preview_state("block:stale").read_text(), "block:new\n")

    def test_failed_open_removes_temp_png(self):
        result = self.run_show(str(self.image), REX_BLOCK="block:caller", FAKE_EXIT="1")
        self.assertEqual(result.stderr.splitlines(), ["rx-show: could not open an image preview"])
        self.assertEqual(list(self.preview_state().parent.glob("image.*.png")), [])
        self.assertFalse(self.preview_state().exists())

    def test_bad_image_leaves_preview_open(self):
        self.set_preview()
        self.image.write_bytes(b"bad")
        result = self.run_show(str(self.image), REX_BLOCK="block:caller")
        self.assertEqual(result.stderr.splitlines(), ["rx-show: could not convert the image"])
        self.assertEqual(self.calls(), [])
        self.assertEqual(self.preview_state().read_text(), "block:old\n")

    def test_conversion_uses_stdin_first_frame_and_orientation(self):
        for extension in ("png", "jpg", "jpeg", "gif", "webp"):
            with self.subTest(extension=extension):
                source = self.root / f"detail %d [1].{extension}"
                source.write_bytes(b"original bytes")
                result = self.run_show(str(source))
                self.assertIn("opened a tab", result.stderr)
                format = "jpeg" if extension == "jpg" else extension
                self.assertEqual(self.recorded("converter"), [f"{format}:-[0]", "-auto-orient", "png:-"])
                self.assertEqual((self.records / "converter-input").read_bytes(), b"original bytes")

    def isolated_path(self):
        folder = self.root / "isolated"
        folder.mkdir()
        for name in ("realpath", "basename", "tr", "dirname", "mkdir", "mktemp", "rm", "python3"):
            (folder / name).symlink_to(shutil.which(name))
        (folder / "rex").symlink_to(self.bin / "rex")
        return folder

    def test_convert_fallback(self):
        folder = self.isolated_path()
        (folder / "convert").symlink_to(self.bin / "magick")
        result = self.run_show(str(self.image), PATH=str(folder))
        self.assertIn("opened a tab", result.stderr)

    def test_missing_converter_leaves_preview_open(self):
        self.set_preview()
        result = self.run_show(str(self.image), REX_BLOCK="block:caller", PATH=str(self.isolated_path()))
        self.assertEqual(result.stderr.splitlines(), ["rx-show: no image converter: install ImageMagick"])
        self.assertEqual(self.calls(), [])
        self.assertEqual(self.preview_state().read_text(), "block:old\n")

    def test_kitty_chunks_preserve_png(self):
        payload = png_data() + bytes(range(256)) * 40
        self.image.write_bytes(payload)
        result = subprocess.run(
            [str(RX_SHOW.with_name("rx-show-kitty")), str(self.image)],
            env={**os.environ, "COLUMNS": "999"}, capture_output=True,
        )
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertFalse(result.stdout.endswith(b"\n"))
        packets = result.stdout.split(b"\x1b\\")[:-1]
        encoded = []
        for index, packet in enumerate(packets):
            header, part = packet.split(b";", 1)
            prefix = b"\x1b_Gf=100,a=T,C=1," if index == 0 else b"\x1b_G"
            more = int(index < len(packets) - 1)
            self.assertEqual(header, prefix + f"m={more}".encode())
            self.assertLessEqual(len(part), 4096)
            if more:
                self.assertEqual(len(part), 4096)
            encoded.append(part)
        self.assertEqual(base64.b64decode(b"".join(encoded)), payload)

    def test_kitty_uses_terminal_pixels_and_fits_images(self):
        loader = importlib.machinery.SourceFileLoader("kitty", str(RX_SHOW.with_name("rx-show-kitty")))
        module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
        loader.exec_module(module)
        with patch.object(module.fcntl, "ioctl", return_value=struct.pack("HHHH", 30, 100, 1000, 600)):
            with patch.dict(os.environ, {"COLUMNS": "999"}):
                pane = module.pane_size()
        self.assertEqual(pane, (30, 100, 1000, 600))
        self.assertEqual(module.image_size_key(png_data(100, 100), pane), "")
        self.assertEqual(module.image_size_key(png_data(100, 1200), pane), "r=30,")
        self.assertEqual(module.image_size_key(png_data(2000, 400), pane), "c=100,")
        self.assertEqual(module.image_size_key(png_data(100, 1200), (30, 100, 0, 0)), "")
        self.assertEqual(module.image_size_key(png_data(2000, 400), (30, 100, 0, 0)), "c=100,")

    def test_kitty_redraws_on_terminal_resize(self):
        for width, height, initial_key in ((900, 1600, b"r=30,"), (100, 100, b"")):
            with self.subTest(width=width, height=height):
                self.image.write_bytes(png_data(width, height))
                master, slave = pty.openpty()
                fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", 30, 100, 1000, 600))

                def attach_terminal():
                    os.setsid()
                    fcntl.ioctl(slave, termios.TIOCSCTTY, 0)

                process = subprocess.Popen(
                    [str(RX_SHOW.with_name("rx-show-kitty")), "--remove", str(self.image)],
                    stdin=slave, stdout=slave, stderr=slave, preexec_fn=attach_terminal,
                )
                os.close(slave)

                def read_draw():
                    output = b""
                    deadline = time.monotonic() + 5
                    while time.monotonic() < deadline:
                        ready, _, _ = select.select([master], [], [], 0.1)
                        if ready:
                            output += os.read(master, 65536)
                            if b"m=0;" in output and output.endswith(b"\x1b\\"):
                                return output
                    self.fail(f"No complete draw: {output[:100]!r}")

                try:
                    first = read_draw()
                    self.assertTrue(first.startswith(b"\x1b_Gf=100,a=T,C=1," + initial_key + b"m="))
                    self.assertIsNone(process.poll())
                    self.assertFalse(self.image.exists())
                    fcntl.ioctl(master, termios.TIOCSWINSZ, struct.pack("HHHH", 5, 5, 50, 50))
                    second = read_draw()
                    prefix = b"\x1b_Ga=d\x1b\\\x1b[2J\x1b[H\x1b_Gf=100,a=T,C=1,"
                    resized_key = b"r=5," if height > width else b"c=5,"
                    self.assertTrue(second.startswith(prefix + resized_key + b"m="))
                    self.assertNotIn(b"\n", second)
                    self.assertIsNone(process.poll())
                finally:
                    process.terminate()
                    process.wait(timeout=5)
                    os.close(master)

    def test_missing_push_config_still_opens_window(self):
        result = self.run_show(str(self.doc))
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIsNotNone(self.recorded("rex"))
        self.assertIn("has no command", result.stderr)

    def test_failed_push_does_not_fail(self):
        self.set_push_command("fake-push\n")
        result = self.run_show(str(self.doc), FAKE_EXIT="1")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn("could not open a tab", result.stderr)
        self.assertIn("the push failed", result.stderr)

    def test_switches_turn_off_window_and_push(self):
        self.set_push_command("fake-push\n")
        result = self.run_show(str(self.doc), RX_SHOW_WINDOW="0", RX_SHOW_PUSH="0")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIsNone(self.recorded("rex"))
        self.assertIsNone(self.recorded("fake-push"))

    def test_push_path_with_spaces_and_wildcard_runs_as_one_program(self):
        folder = self.root / "push tools"
        folder.mkdir()
        tool = folder / "push*"
        tool.write_text(RECORDER)
        tool.chmod(0o755)
        self.set_push_command(f"{tool}\n")
        result = self.run_show(str(self.doc), RX_SHOW_WINDOW="0")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(self.recorded("push*"), [str(self.doc)])

    def test_push_line_is_not_split_or_expanded(self):
        self.set_push_command("fake-push *\n")
        result = self.run_show(str(self.doc), RX_SHOW_WINDOW="0")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIsNone(self.recorded("fake-push"))
        self.assertIn("the push failed", result.stderr)

    def test_file_name_with_leading_hyphen(self):
        self.set_push_command("fake-push\n")
        (self.root / "-draft.md").write_text("# Draft\n")
        result = subprocess.run(
            [str(RX_SHOW), "-draft.md"],
            cwd=self.root,
            env={
                **os.environ,
                "PATH": f"{self.bin}:{os.environ['PATH']}",
                "RECORD_DIR": str(self.records),
                "XDG_CONFIG_HOME": str(self.config),
            },
            capture_output=True,
            text=True,
        )
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(self.recorded("rex")[-1], str(self.root / "-draft.md"))
        self.assertEqual(self.recorded("fake-push"), [str(self.root / "-draft.md")])

    def test_window_switch_alone_keeps_push(self):
        self.set_push_command("fake-push\n")
        result = self.run_show(str(self.doc), RX_SHOW_WINDOW="0")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIsNone(self.recorded("rex"))
        self.assertEqual(self.recorded("fake-push"), [str(self.doc)])

    def test_other_file_opens_less(self):
        text = self.root / "run.txt"
        text.write_text("output\n")
        result = self.run_show(str(text), RX_SHOW_PUSH="0")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(self.recorded("rex")[-2:], ["less", str(text)])

    def test_missing_file_is_usage_error(self):
        result = self.run_show(str(self.root / "none.md"))
        self.assertEqual(result.returncode, 1)
        self.assertIn("Usage", result.stderr)


if __name__ == "__main__":
    unittest.main()
