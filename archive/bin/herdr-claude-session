#!/usr/bin/env python3

import argparse
import json
from pathlib import Path
import subprocess
import sys


def session_name(agent_name):
    result = subprocess.run(
        ["herdr", "agent", "get", agent_name], capture_output=True, text=True
    )
    if result.returncode:
        raise ValueError(f"agent {agent_name} not found")
    try:
        agent = json.loads(result.stdout)["result"]["agent"]
    except (ValueError, KeyError, TypeError):
        raise ValueError(f"agent {agent_name} not found") from None
    if not isinstance(agent, dict):
        raise ValueError(f"agent {agent_name} not found")
    if agent.get("agent") != "claude":
        raise ValueError(f"agent {agent_name} is not claude")
    session = agent.get("agent_session")
    session_id = session.get("value") if isinstance(session, dict) else None
    if not session_id:
        raise ValueError(f"agent {agent_name} has no session ID")
    for path in sorted((Path.home() / ".claude/sessions").glob("*.json")):
        try:
            session = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if isinstance(session, dict) and session.get("sessionId") == session_id:
            name = session.get("name")
            if name:
                return name
    raise ValueError(f"session file for {agent_name} not found")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("agent")
    args = parser.parse_args()
    try:
        print(session_name(args.agent))
    except (ValueError, OSError) as error:
        print(f"herdr-claude-session: {str(error).splitlines()[0]}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
